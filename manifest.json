{
  "manifest_version": 3,
  "name": "Hello World Extension",
  "version": "1.0",
  "description": "Simple right-click menu extension",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
} 